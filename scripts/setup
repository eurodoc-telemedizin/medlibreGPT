#!/usr/bin/env python3
import os
import time
import random
import argparse
from typing import Callable, Any, Dict

from huggingface_hub import hf_hub_download, snapshot_download
from huggingface_hub.utils import HfHubHTTPError
from transformers import AutoTokenizer

from private_gpt.paths import models_path, models_cache_path
from private_gpt.settings.settings import settings


def maybe_enable_hf_transfer():
    """
    If hf_transfer is installed, enable the high-performance downloader.
    This is a no-op if the package isn't present.
    """
    try:
        import hf_transfer  # noqa: F401
        os.environ.setdefault("HF_HUB_ENABLE_HF_TRANSFER", "1")
        # Slightly lower concurrency to be polite to CAS:
        os.environ.setdefault("HF_HUB_ENABLE_HF_TRANSFER_MAX_WORKERS", "4")
    except Exception:
        # Not installed; ignore
        pass


def with_retries(fn: Callable[..., Any], *, attempts: int = 6, base_delay: float = 1.0, **kwargs) -> Any:
    """
    Run a huggingface-hub download function with retries and exponential backoff + jitter.
    Retries on transient HTTP 5xx errors and connection resets.
    """
    for i in range(attempts):
        try:
            return fn(**kwargs)
        except Exception as e:
            # Decide whether to retry
            retryable = False
            status = None
            if isinstance(e, HfHubHTTPError) and hasattr(e, "response") and e.response is not None:
                try:
                    status = e.response.status_code
                    if 500 <= status < 600:
                        retryable = True
                except Exception:
                    pass
            # Generic network/transient errors (connection reset, timeout, etc.)
            msg = str(e).lower()
            if any(k in msg for k in ["connection reset", "timed out", "temporarily unavailable", "server error"]):
                retryable = True

            if i < attempts - 1 and retryable:
                sleep_s = base_delay * (2 ** i) + random.uniform(0, 0.5)
                print(f"[retry] {type(e).__name__} (status={status}) — attempt {i+1}/{attempts-1}, sleeping {sleep_s:.1f}s")
                time.sleep(sleep_s)
                continue
            # Last attempt or non-retryable → raise
            raise


def main():
    parser = argparse.ArgumentParser(prog="Setup: Download models from Hugging Face")
    parser.add_argument(
        "--resume",
        default=True,
        action=argparse.BooleanOptionalAction,
        help="Enable/Disable resume_download to resume interrupted downloads",
    )
    parser.add_argument(
        "--include-large-exports",
        default=False,
        action=argparse.BooleanOptionalAction,
        help="Also download ONNX/OpenVINO/TFLite artifacts (disabled by default to avoid flaky 500s)",
    )
    parser.add_argument(
        "--max-workers",
        type=int,
        default=int(os.environ.get("HF_MAX_WORKERS", "2")),
        help="Worker threads for snapshot_download (default: 2)",
    )
    args = parser.parse_args()
    resume_download = bool(args.resume)
    include_large = bool(args.include_large_exports)
    max_workers = int(args.max_workers)

    os.makedirs(models_path, exist_ok=True)

    # Enable faster downloader if available
    maybe_enable_hf_transfer()

    # Common kwargs
    token = settings().huggingface.access_token
    cache_dir = str(models_cache_path)

    # (A) Download Embedding model — filter out giant/optional exports by default
    embedding_repo = settings().huggingface.embedding_hf_model_name
    embedding_path = models_path / "embedding"
    print(f"Downloading embedding {embedding_repo}")

    allow_patterns = None
    ignore_patterns = None
    if not include_large:
        # Keep the essentials; skip heavy alt runtimes that frequently 500 on CAS
        # You can tweak this list as needed for your repo.
        allow_patterns = [
            "README.*",
            "LICENSE*",
            "config.json",
            "tokenizer*",
            "vocab*",
            "merges.txt",
            "sentencepiece.*",
            "special_tokens_map.json",
            "sentence_bert_config.json",
            "model.safetensors",  # main weights
            "pytorch_model.bin",  # some repos still use this
        ]
        # Also explicitly ignore common heavy directories/exports
        ignore_patterns = [
            "onnx/*",
            "*.onnx",
            "openvino/*",
            "tflite/*",
            "tf/*",
            "flax/*",
        ]

    snapshot_kwargs: Dict[str, Any] = dict(
        repo_id=embedding_repo,
        cache_dir=cache_dir,
        local_dir=str(embedding_path),
        local_dir_use_symlinks=False,  # safer across filesystems/containers
        token=token,
        resume_download=resume_download,
        max_workers=max_workers,
    )
    if allow_patterns is not None:
        snapshot_kwargs["allow_patterns"] = allow_patterns
    if ignore_patterns is not None:
        snapshot_kwargs["ignore_patterns"] = ignore_patterns

    with_retries(snapshot_download, **snapshot_kwargs)
    print("Embedding model downloaded!")

    # (B) Download LLM file
    print(f"Downloading LLM {settings().llamacpp.llm_hf_model_file}")
    with_retries(
        hf_hub_download,
        repo_id=settings().llamacpp.llm_hf_repo_id,
        filename=settings().llamacpp.llm_hf_model_file,
        cache_dir=cache_dir,
        local_dir=str(models_path),
        local_dir_use_symlinks=False,
        resume_download=resume_download,
        token=token,
    )
    print("LLM model downloaded!")

    # (C) Download Tokenizer (if specified)
    if settings().llm.tokenizer:
        tok_repo = settings().llm.tokenizer
        print(f"Downloading tokenizer {tok_repo}")
        # AutoTokenizer will pull via huggingface_hub under the hood;
        # we can't easily inject our retry loop, but transfer+cache settings still help.
        AutoTokenizer.from_pretrained(
            pretrained_model_name_or_path=tok_repo,
            cache_dir=cache_dir,
            token=token,
            use_fast=True,
        )
        print("Tokenizer downloaded!")

    print("Setup done")


if __name__ == "__main__":
    main()
